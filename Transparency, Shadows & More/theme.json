{
    "name": "Transparency, Shadows & More",
    "author": "Leozito",
    "version": "v1.0",
    "description": "Control transparency and shadows from interface elements for better visibility.",
    "target": "System-Wide",
    "manifest_version": 9,
    "tabs": {
        "default": [ "bigpicture", "MainMenu", "QuickAccess" ]
    },
    "inject": {
        "shared.css": []
    },
