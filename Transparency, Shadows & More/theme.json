            "type": "none",
            "values": {
                "_": {}
            }
        },
        "Header Background": {
            "type": "dropdown",
            "default": "Transparent",
            "values": {
                "Default": {},
                "Transparent": {
                    "general/header-background.css": []
                },
                "Blur": {
                    "general/header-background.css": [],
                    "--tsam-header-backdrop-filter": [ "var(--tsam-blur)" ]
                },
                "★ Glass": {
                    "general/header-background.css": [],
                    "--tsam-header-background": [ "var(--tsam-glass)" ]
                },
                "OLED Black": {
